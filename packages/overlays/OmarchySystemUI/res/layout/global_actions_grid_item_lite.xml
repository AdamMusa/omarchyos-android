<com.android.systemui.globalactions.GlobalActionsItem
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical">
    <ImageView
        android:id="@*android:id/icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="12dp"
        android:padding="32dp"
        android:scaleType="centerInside"
        android:tint="@android:color/system_on_surface_dark"
        android:background="@drawable/global_actions_lite_button" />
    <!-- Give Flow a known wrapping width before it measures the grid. A
         match-parent label can otherwise keep a one-line measured height.
         No ellipsis: native GlobalActionsLayoutLite enables marquee for
         truncated labels. Wrapping retains the user's chosen text size. -->
    <TextView
        android:id="@*android:id/message"
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:singleLine="false"
        android:scrollHorizontally="false"
        android:maxLines="10"
        android:ellipsize="none"
        android:textSize="14sp"
        android:fontFamily="omarchy-ui"
        android:gravity="center"
        android:textColor="@android:color/system_on_surface_dark"
        android:textAppearance="?android:attr/textAppearanceSmall" />
</com.android.systemui.globalactions.GlobalActionsItem>
