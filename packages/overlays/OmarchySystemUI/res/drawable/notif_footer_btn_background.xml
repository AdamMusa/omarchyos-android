<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <padding android:left="20dp" android:right="20dp" />
                <solid android:color="@android:color/system_surface_container_high_dark" />
                <stroke android:width="1dp" android:color="@android:color/system_outline_dark" />
            </shape>
        </inset>
    </item>
</ripple>
