<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/code_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/code_accent" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/code_surface" />
            <stroke android:width="1dp" android:color="@color/code_outline" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
