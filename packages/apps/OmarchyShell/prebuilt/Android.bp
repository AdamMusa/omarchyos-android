// OmarchyShell as the device's shell.
//
// The APK itself is built outside the platform tree: it is a Qt application,
// so it needs the Qt toolchain and gradle rather than Soong. tools/build-apk.sh
// produces it and it is imported here as a prebuilt.
//
// Keep Quickstep installed: it owns Android's gesture/overview service even
// when Omarchy is the selected HOME activity. The platform certificate is
// required because the shell
// holds signature permissions (it reads the notification stream, sets the
// lock state and reaches system services on the user's behalf).
android_app_import {
    name: "OmarchyShell",
    apk: "OmarchyShell.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    // The product copies the shared privilege allowlist and preferred Home XML.
    dex_preopt: {
        enabled: false,
    },
}

// Bash is an executable, not a shared library. APK installs extract it with
// execute permission, but system app libraries are installed as 0644. Install
// the same bundled binary in bin/ so the built-in Home can scan its plugins.
python_binary_host {
    name: "omarchy_extract_bash",
    main: "extract-bash.py",
    srcs: ["extract-bash.py"],
}

genrule {
    name: "omarchy_bash_from_apk",
    tools: ["omarchy_extract_bash"],
    srcs: ["OmarchyShell.apk"],
    out: ["bash"],
    cmd: "$(location omarchy_extract_bash) $(in) $(out)",
}

cc_prebuilt_binary {
    name: "omarchy_bash",
    stem: "bash",
    system_ext_specific: true,
    compile_multilib: "64",
    arch: {
        arm64: { srcs: [":omarchy_bash_from_apk"] },
    },
    strip: { none: true },
    check_elf_files: false,
    static_executable: true,
}
