<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/omarchy_surface_elevated"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="82dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="14dp"
    android:paddingBottom="13dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/theme_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/omarchy_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/theme_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/omarchy_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/theme_swatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <TextView
        android:id="@+id/theme_selected"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_selected_theme"
        android:contentDescription="@string/active"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/omarchy_surface"
        android:textSize="16sp" />
</LinearLayout>
