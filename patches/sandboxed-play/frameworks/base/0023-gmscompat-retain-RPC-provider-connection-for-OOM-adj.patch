From: inthewaves <inthewaves@pm.me>
Date: Sun, 2 Aug 2026 00:40:51 -0700
Subject: [PATCH 23/28] gmscompat: retain RPC provider connection for OOM
 adjustment

If GmsCompat's oom_score_adj is greater than the oom_score_adj of a foreground app that depends on
GmsCore, GmsCompat is more likely to get killed first under system memory pressure which will
kill the foreground app via the DeathRecipient's System.exit(1)

To verify, run

    adb shell 'pid=$(pidof app.grapheneos.gmscompat); cat "/proc/$pid/oom_score_adj"'

If GmsCompat dies, this new stable provider connection means Android will kill dependent clients
with ApplicationExitInfo.REASON_DEPENDENCY_DIED [^1]. However, this isn't much different from the
current behavior of System.exit(1) on GmsCompat binder death.

Test: Running above command with foreground app that depends on GmsCore shows
app.grapheneos.gmscompat has a oom_score_adj of 0 (same as foreground app's oom_score_adj)
Test: Running above command with foreground app that doesn't depends on GmsCore shows
app.grapheneos.gmscompat has a oom_score_adj of 200

[^1]: https://github.com/GrapheneOS/platform_frameworks_base/blob/2026072900/services/core/java/com/android/server/am/ContentProviderHelper.java#L1856
---
 .../internal/gmscompat/GmsCompatApp.java      | 26 +++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/core/java/com/android/internal/gmscompat/GmsCompatApp.java b/core/java/com/android/internal/gmscompat/GmsCompatApp.java
index 086e21aa72dd..e0a098442479 100644
--- a/core/java/com/android/internal/gmscompat/GmsCompatApp.java
+++ b/core/java/com/android/internal/gmscompat/GmsCompatApp.java
@@ -20,6 +20,7 @@ import android.Manifest;
 import android.accounts.AccountManager;
 import android.annotation.Nullable;
 import android.app.compat.gms.GmsCompat;
+import android.content.ContentProviderClient;
 import android.content.Context;
 import android.database.ContentObserver;
 import android.net.ConnectivityManager;
@@ -103,6 +104,24 @@ public final class GmsCompatApp {
     }
 
     private static final String RPC_PROVIDER_AUTHORITY = PKG_NAME + ".RpcProvider";
+    // Keep a stable provider connection for the process lifetime so that ActivityManager propagates
+    // this process's OOM adjustment to GmsCompat. If GmsCompat dies, this stable provider 
+    // connection means Android will kill clients with ApplicationExitInfo.REASON_DEPENDENCY_DIED
+    private static ContentProviderClient rpcProviderClient;
+
+    private static synchronized ContentProviderClient getRpcProviderClient(Context ctx,
+            String authority) {
+        ContentProviderClient client = rpcProviderClient;
+        if (client == null) {
+            client = ctx.getContentResolver().acquireContentProviderClient(authority);
+            if (client == null) {
+                throw new IllegalStateException("Unable to acquire " + authority);
+            }
+            rpcProviderClient = client;
+        }
+        return client;
+    }
+
     public static final String KEY_BINDER = "binder";
     public static final String KEY_PKG_NAME = "pkg";
 
@@ -111,9 +130,12 @@ public final class GmsCompatApp {
 
     public static Bundle callRpcProvider(Context ctx, int method, String arg, Bundle extras) {
         String authority = RPC_PROVIDER_AUTHORITY;
-        var cr = ctx.getContentResolver();
         try {
-            return cr.call(authority, Integer.toString(method), arg, extras);
+            Bundle result = getRpcProviderClient(ctx, authority).call(Integer.toString(method),
+                    arg, extras);
+            // ContentResolver.call() marks provider results as defusable.
+            Bundle.setDefusable(result, true);
+            return result;
         } catch (Throwable t) {
             Log.e(TAG, "call to " + authority + " failed", t);
             if (GmsCompat.isEnabled()) {
