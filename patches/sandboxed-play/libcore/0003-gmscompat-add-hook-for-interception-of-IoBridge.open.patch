From be4788555dc6b55685ff93a5a7e9fec56381a17a Mon Sep 17 00:00:00 2001
From: Dmitry Muhomor <muhomor.dmitry@gmail.com>
Date: Tue, 6 Jan 2026 14:54:36 +0000
Subject: [PATCH] gmscompat: add hook for interception of IoBridge.open() calls

---
 api/module-lib-current.txt                  |  5 +++++
 luni/src/main/java/libcore/io/IoBridge.java | 20 ++++++++++++++------
 2 files changed, 19 insertions(+), 6 deletions(-)

diff --git a/api/module-lib-current.txt b/api/module-lib-current.txt
index d1e33a7d4..3145a588c 100644
--- a/api/module-lib-current.txt
+++ b/api/module-lib-current.txt
@@ -652,6 +652,11 @@ package libcore.io {
     method @NonNull public static java.io.FileDescriptor open(@NonNull String, int) throws java.io.FileNotFoundException;
     method public static int read(@NonNull java.io.FileDescriptor, @NonNull byte[], int, int) throws java.io.IOException;
     method public static void write(@NonNull java.io.FileDescriptor, @NonNull byte[], int, int) throws java.io.IOException;
+    field @Nullable public static libcore.io.IoBridge.OpenFdInterceptor openFdInterceptor;
+  }
+
+  public static interface IoBridge.OpenFdInterceptor {
+    method @Nullable public java.io.FileDescriptor maybeInterceptOpenFd(@NonNull String, int) throws android.system.ErrnoException;
   }
 
   public final class IoUtils {
diff --git a/luni/src/main/java/libcore/io/IoBridge.java b/luni/src/main/java/libcore/io/IoBridge.java
index fab3d579a..6b2df9c32 100644
--- a/luni/src/main/java/libcore/io/IoBridge.java
+++ b/luni/src/main/java/libcore/io/IoBridge.java
@@ -535,6 +535,17 @@ public final class IoBridge {
         }
     }
 
+    /** @hide */
+    @SystemApi(client = MODULE_LIBRARIES)
+    public interface OpenFdInterceptor {
+        @Nullable FileDescriptor maybeInterceptOpenFd(@NonNull String path, int flags) throws ErrnoException;
+    }
+
+    /** @hide */
+    @Nullable
+    @SystemApi(client = MODULE_LIBRARIES)
+    public static OpenFdInterceptor openFdInterceptor;
+
     /**
      * Wrapper for {@link Os#open(String, int, int)} that behaves similar to {@link java.io.File}.
      * When a {@link java.io.File} is opened and there is an error, it throws
@@ -557,12 +568,9 @@ public final class IoBridge {
     public static @NonNull FileDescriptor open(@NonNull String path, int flags) throws FileNotFoundException {
         FileDescriptor fd = null;
         try {
-            String gmscompatPrefix = "gmscompat_fd_";
-            if (path.startsWith(gmscompatPrefix)) {
-                int fdInt = Integer.parseInt(path.substring(gmscompatPrefix.length()));
-                FileDescriptor jfd = new FileDescriptor();
-                jfd.setInt$(fdInt);
-                fd = Os.getDefault().dup(jfd);
+            OpenFdInterceptor interceptor = openFdInterceptor;
+            if (interceptor != null) {
+                fd = interceptor.maybeInterceptOpenFd(path, flags);
             }
             if (fd == null) {
                 fd = Libcore.os.open(path, flags, 0666);
-- 
2.43.0

