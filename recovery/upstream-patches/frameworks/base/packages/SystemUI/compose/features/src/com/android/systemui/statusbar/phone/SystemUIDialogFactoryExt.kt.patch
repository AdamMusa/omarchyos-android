+/** Keep the shared navigation reachable when a native sheet grows to full height. */
+@Composable
+private fun OmarchyBottomSheetFrame(
+    dialog: SystemUIDialog,
+    modifier: Modifier,
+    contentAlignment: Alignment,
+    content: @Composable BoxScope.() -> Unit,
+) {
+    if (!android.os.Build.BRAND.equals("Omarchy", ignoreCase = true)) {
+        Box(modifier = modifier, contentAlignment = contentAlignment, content = content)
+        return
+    }
+    val context = LocalContext.current
+    val navigationHeight = with(LocalDensity.current) {
+        SystemBarUtils.getStatusBarHeight(context).toDp()
+    }
+    Column(Modifier.fillMaxSize()) {
+        AndroidView(
+            factory = { barContext ->
+                PhoneStatusBarView.OmarchyBar(barContext).apply {
+                    setBeforeOpenPanel { dialog.dismiss() }
+                }
+            },
+            update = { bar -> bar.refreshColors() },
+            modifier = Modifier.fillMaxWidth().height(navigationHeight),
+        )
+        // Keep scrolling, outside-tap dismissal and dragging in the body. The
+        // bar stays fixed, and its native Back key goes to this modal window.
+        Box(
+            modifier = Modifier.weight(1f).fillMaxWidth().then(modifier),
+            contentAlignment = contentAlignment,
+            content = content,
+        )
+    }
+}
