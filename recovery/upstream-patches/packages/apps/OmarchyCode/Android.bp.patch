+// Claude Code's embedded Bun resolver expects a Linux resolv.conf, while
+// Android deliberately routes DNS through netd instead. This tiny musl preload
+// redirects only that one pathname to a per-user file maintained from Android
+// LinkProperties by TerminalService.
+cc_library_shared {
+    name: "libomarchy_resolv_compat",
+    srcs: ["compat/resolv_compat.c"],
+    stem: "libomarchy_resolv_compat",
+    relative_install_path: "omarchy-code/claude",
+    compile_multilib: "64",
+    system_ext_specific: true,
+    system_shared_libs: [],
+    allow_undefined_symbols: true,
+    stl: "none",
